# Copy to .env and change the values.

APP_ENV=development

# Long random value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value-of-at-least-32-characters

# The first owner account, created only when the database has no users.
# Log in with these, then change the password from "My account".
OWNER_USERNAME=owner
OWNER_PASSWORD=ChangeMe123!
OWNER_NAME=Owner

# Website address(es) allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:3000
