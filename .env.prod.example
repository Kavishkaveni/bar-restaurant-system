# Settings for the live server. Copy to .env.prod and fill in every value.
#   cp .env.prod.example .env.prod
#   nano .env.prod

# Your domain, without https:// (its DNS "A" record must point to this server).
DOMAIN=pos.example.lk

# Long random values. Make each one with:
#   openssl rand -base64 36
POSTGRES_PASSWORD=
JWT_SECRET=

# The first owner login, used only the very first time the system starts.
# Change the password from "My account" after logging in.
OWNER_USERNAME=owner
OWNER_PASSWORD=
OWNER_NAME=Owner

# Daily database backup: time (Sri Lanka time) and how many days to keep.
BACKUP_TIME=03:00
BACKUP_KEEP=14
